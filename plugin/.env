# Where the plugin gets installed. Committed, so nothing of yours here: set your vaults in .env.local (gitignored),
# which wins over this file. Each is a vault's folder, no quotes; the plugin goes to its .obsidian/plugins/rock-sync.

# npm run dev: the test vault, rebuilt into it on every change for Hot Reload. Never a real vault.
DEV_VAULT=../../test-vault
# make desktop-install: a vault on this machine, a minified build.
DESKTOP_VAULT=
# make phone-install: a vault on the phone over adb, a minified build (/sdcard/Documents/<...>/<vault>).
ADB_VAULT=
