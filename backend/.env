# Every setting of the server, with its dev default. Committed, so no secrets here: to change a value, set it in
# .env.local (gitignored), which wins over this file; the process environment wins over both.
# Both files are read from the directory the server starts in (backend/); relative paths below start there too.
# The image contains neither (.dockerignore): pass the settings with `docker run -e` / compose.

# --- Apps

# What this process serves, comma-separated: sync (the sync API: what devices use), mcp (/mcp, for Claude), admin
# (/admin, needs the admin panel's settings below). Unset: sync. Empty, or another name → the server doesn't start.
# Processes of the same image may share VAULTS_DIR and DB_DIR, each serving its own: keep admin in one that nothing
# public (a proxy, a tunnel) reaches. Dev: sync and mcp; add admin once its settings are in .env.local.
ENABLED_APPS=sync,mcp
# The vaults this process's sync API serves, comma-separated (work); every other vault's device tokens and connection
# codes are refused like wrong ones (a code is used up). For a process others reach: only their vaults. Empty: all.
# MCP isn't limited by it (its tokens' grants are). A name that can't be a vault's → the server doesn't start.
ALLOWED_VAULTS=

# --- Storage

# The vaults: <VAULTS_DIR>/<vault>/tree + repo.git. Never created: missing → the server doesn't start.
VAULTS_DIR=tmp/data
# The database's directory (vault-sync.db: vaults and tokens). The file is created, the directory isn't: missing → the
# server doesn't start. Keep it outside VAULTS_DIR: storage that isn't mounted must not look like a fresh install.
DB_DIR=tmp/db

# --- Limits

# Largest request body, in bytes (100 MB); bigger → 413.
MAX_FILE_SIZE=104857600
# The most one MCP tool call may write, in bytes (20 MB: the plugin's limit on phones).
MCP_MAX_WRITE=20971520

# --- First run

# Made at boot if missing, so a container needs nothing else to start syncing. A restart changes nothing: what the admin
# panel did to the vault stands. Only a process serving sync acts on them (the code is used there); others only check
# they're valid.
# The vault to create, [a-z0-9-].
INIT_VAULT_NAME=
# A connection code for its first device, needs INIT_VAULT_NAME: 6 digits, typed into the plugin's Connect. No expiry,
# unlike the admin panel's codes, but once a device of the vault has a token it's gone for good, a restart doesn't bring
# it back. 5 wrong codes in a row burn it until the next restart.
INIT_VAULT_CODE=

# --- Admin panel (/admin)
# Only with admin in ENABLED_APPS, which needs user, password and session secret: missing, or only some set → the server
# doesn't start. Set without admin enabled: a line in the log, nothing else.

# The address devices reach this server at (https://notes.example.com): the panel gives it out with a connection code.
# Required with the panel: without it the server doesn't start.
PUBLIC_URL=http://localhost:9292
ADMIN_USER=
ADMIN_PASSWORD=
# Optional, and worth having: without it the password alone protects the panel. Base32, at least 128 bits:
# `make totp-secret`. The same string goes into your authenticator.
ADMIN_TOTP_SECRET=
# Signs the session cookie, at least 64 bytes: `make session-secret`.
SESSION_SECRET=

# --- MCP

# The endpoint is there with mcp in ENABLED_APPS (MCP_ENABLED is gone: set → the server doesn't start).
# The origin Claude reaches this server at (https://notes.example.com), when it isn't PUBLIC_URL: the admin panel builds
# a new token's MCP URL from it. Empty: PUBLIC_URL.
MCP_BASE_URL=

# --- Development

# Reload lib/ and services/ when they change. Leave off in production.
ZEITWERK_RELOAD=true
# Write verbose logs for every HTTP request. For debugging, not for production
VERBOSE_HTTP_LOGS=true

# --- Publishing the image (make push)

# GHCR account: ghcr.io/<GHCR_USER>/obsidian-rock-sync. The Makefile reads it from the environment or .env.local, not from here.
GHCR_USER=
# PAT with write:packages, for `make ghcr-login`; read like GHCR_USER. A secret: only ever in .env.local.
GHCR_TOKEN=

# --- Set by the image, not needed in dev

# production: Puma listens on 0.0.0.0:$PORT, no Rack::Lint, secure session cookie. Don't leave it empty here.
# RACK_ENV=production
# The port in production (rackup in dev: 9292, its -p).
# PORT=9292
